# Copy this file to .env and fill in your values. Never commit the real .env.

# Your Jira Cloud domain, no https://
JIRA_DOMAIN=YOUR DOMAIN

# Your Jira login email
JIRA_EMAIL=mail@mail.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token-here

# Absolute path to your local git repo (use forward slashes)
REPO_PATH=C:/Users/your-project-folder-endpoint

# Branch to base new work off of
BASE_BRANCH=your-base-branch

# Port for the local dashboard
PORT=4177

# Interface to bind. Leave as loopback — this server runs Claude with write
# access to your repos and has no authentication, so anyone who can reach the
# port can run code on this machine. Setting a specific non-loopback address
# does work (the request allowlist follows the bind, and startup warns loudly);
# 0.0.0.0 binds everything but still only accepts loopback Host headers.
HOST=127.0.0.1

# Optional, and off by default: Telegram notifications when a plan is ready for
# review or a run finishes/fails. All three can also be set from the Settings tab.
# Create a bot via @BotFather to get a token, message it once, then find your
# chat ID via @userinfobot (or the bot's getUpdates endpoint).
#
# Nothing is ever sent unless TELEGRAM_ENABLED is true (or you tick the box in
# Settings) — storing a token on its own does not start sending messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
